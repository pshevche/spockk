{
  "name": "spockk-docs",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "vitepress dev docs",
    "build": "vitepress build docs",
    "preview": "vitepress preview docs",
    "lint": "eslint docs eslint.config.mjs",
    "lint:fix": "eslint docs eslint.config.mjs --fix",
    "format": "prettier --write docs *.mjs *.json",
    "format:check": "prettier --check docs *.mjs *.json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "eslint-plugin-yet-another-license-header": "^1.0.0",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.66.0",
    "vitepress": "^1.6.4",
    "vue": "^3.5.41",
    "vue-eslint-parser": "^10.4.1"
  }
}
